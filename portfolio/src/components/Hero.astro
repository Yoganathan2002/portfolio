---
import DNAAnimation from './DNAAnimation.jsx';
---

<section class="relative min-h-screen flex flex-col justify-center items-start pt-32 pb-32 px-6 sm:px-8 lg:px-16 overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 opacity-60 hidden lg:flex items-center justify-center">
      <div class="absolute w-96 h-96"><DNAAnimation client:load /></div>
    </div>
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-0 w-96 h-96 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(0, 181, 173, 0.3);"></div>
      <div class="absolute top-0 right-0 w-96 h-96 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(245, 166, 35, 0.3);"></div>
      <div class="absolute bottom-0 left-1/2 w-96 h-96 rounded-full mix-blend-multiply blur-3xl -translate-x-1/2" style="background-color: rgba(0, 181, 173, 0.2);"></div>
    </div>
  </div>

  <div class="max-w-5xl relative z-10">
    <div class="inline-block mb-8 sm:mb-12">
      <div class="cellular-card px-4 py-2 text-xs font-medium" style="color: var(--color-dark); border-color: var(--color-teal);">
        <span class="inline-block w-2 h-2 rounded-full mr-2 animate-pulse" style="background-color: var(--color-teal);"></span>
        <span class="glow-text-teal">AVAILABLE FOR OPPORTUNITIES</span> · Building intelligent systems
      </div>
    </div>

    <div class="space-y-6 sm:space-y-8">
      <h1 class="text-6xl sm:text-7xl lg:text-8xl font-bold leading-tight" style="color: var(--color-dark);">
        <span class="block">Yoganathan</span>
        <span class="glow-text block">Vinayagam</span>
      </h1>

      <p class="text-lg sm:text-xl lg:text-2xl max-w-3xl leading-relaxed glow-text-teal font-medium">
        Innovating at the intersection of<br />
        <span class="block mt-2">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-orange-500">AI</span> ·
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-teal-500">XR</span> ·
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-orange-500">Backend Systems</span>
        </span>
      </p>

      <p class="text-base sm:text-lg max-w-3xl leading-relaxed" style="color: var(--color-dark); opacity: 0.85;">
        Building intelligent interfaces and robust systems. Passionate about clean architecture, performance, and creating intuitive products.
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap gap-4 pt-4 sm:pt-8">
        <a href="#projects" class="btn-primary text-center">Explore Projects</a>
        <a href="#contact" class="btn-secondary text-center">Get in Touch</a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce z-10 hidden sm:block">
    <div class="flex flex-col items-center gap-3">
      <p class="text-xs font-medium glow-text-teal uppercase tracking-widest">Scroll to explore</p>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-teal);">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </div>
</section>
