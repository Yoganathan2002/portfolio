---
---

<section id="contact" class="relative py-20 sm:py-28 px-6 sm:px-8 lg:px-16 overflow-hidden">
  <div class="absolute inset-0 -z-10 opacity-20">
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(245, 166, 35, 0.3);"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(0, 181, 173, 0.3);"></div>
  </div>

  <div class="max-w-4xl mx-auto relative z-10 text-center">
    <div class="mb-16 sm:mb-20">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6" style="color: var(--color-dark);">
        Let's <span class="glow-text">Connect</span>
      </h2>
      <p class="text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed" style="color: var(--color-dark); opacity: 0.85;">
        I'm interested in new projects and opportunities. Let's explore how we can build something extraordinary together.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <div class="cellular-card p-8 sm:p-10 group">
        <div class="flex justify-center mb-6">
          <div class="w-16 h-16 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, rgba(0, 181, 173, 0.1), rgba(245, 166, 35, 0.1));">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-teal);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-bold mb-3 glow-text-teal">Email</h3>
        <p class="text-sm mb-6" style="color: var(--color-dark); opacity: 0.75;">Get in touch directly</p>
        <a href="mailto:yoganathan@example.com" class="btn-secondary text-center w-full">Send Email</a>
      </div>

      <div class="cellular-card p-8 sm:p-10 group">
        <div class="flex justify-center mb-6">
          <div class="w-16 h-16 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, rgba(245, 166, 35, 0.1), rgba(0, 181, 173, 0.1));">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" style="color: var(--color-orange);">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-bold mb-3 glow-text-teal">LinkedIn</h3>
        <p class="text-sm mb-6" style="color: var(--color-dark); opacity: 0.75;">Connect on LinkedIn</p>
        <a href="https://linkedin.com" class="btn-secondary text-center w-full">Visit Profile</a>
      </div>
    </div>

    <div class="relative">
      <p class="text-sm font-semibold glow-text-teal uppercase tracking-widest mb-8">Or find me on</p>
      <div class="flex justify-center gap-8 flex-wrap">
        <a href="https://github.com" class="social-icon">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a href="https://twitter.com" class="social-icon">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417a9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
          </svg>
        </a>
        <a href="https://discord.com" class="social-icon">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.211.375-.444.864-.607 1.25a18.27 18.27 0 00-5.487 0c-.163-.386-.395-.875-.607-1.25a.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.042-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.294.075.075 0 01.078-.01c3.928 1.793 8.18 1.793 12.062 0a.075.075 0 01.079.009c.12.098.246.198.373.294a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.076.076 0 00-.041.107c.36.699.77 1.364 1.225 1.994a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-4.467.151-8.35-.882-12.487a.07.07 0 00-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.952-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.952 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.952-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.419-2.157 2.419z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .social-icon {
    @apply w-12 h-12 rounded-full flex items-center justify-center transition-all duration-300;
    background: linear-gradient(135deg, rgba(0, 181, 173, 0.1), rgba(245, 166, 35, 0.1));
    border: 1px solid var(--color-cell-border);
    color: var(--color-teal);
  }

  .social-icon:hover {
    background: linear-gradient(135deg, rgba(0, 181, 173, 0.2), rgba(245, 166, 35, 0.2));
    border-color: var(--color-teal);
    box-shadow: 0 0 20px rgba(0, 181, 173, 0.3);
    transform: translateY(-4px) scale(1.1);
  }
</style>
