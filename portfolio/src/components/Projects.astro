---
---

<section id="projects" class="relative py-20 sm:py-28 px-6 sm:px-8 lg:px-16 overflow-hidden">
  <div class="absolute inset-0 -z-10 opacity-15">
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(0, 181, 173, 0.2);"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(245, 166, 35, 0.2);"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="mb-16 sm:mb-24 text-center">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6" style="color: var(--color-dark);">
        Featured <span class="glow-text">Projects</span>
      </h2>
      <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, var(--color-teal), var(--color-orange));"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="cellular-card p-8 h-full flex flex-col group hover:translate-y-[-2rem]">
        <div class="mb-6 p-6 rounded-xl" style="background: linear-gradient(135deg, rgba(0, 181, 173, 0.1), rgba(245, 166, 35, 0.1));">
          <svg viewBox="0 0 100 100" class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="50" cy="50" r="40" opacity="0.6"/>
            <path d="M 30 50 Q 50 30, 70 50 Q 50 70, 30 50" opacity="0.4"/>
            <circle cx="50" cy="50" r="8" fill="currentColor" opacity="0.8"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold mb-3 glow-text-teal">Neural Interface Engine</h3>
        <p class="text-sm mb-6 flex-grow" style="color: var(--color-dark); opacity: 0.85;">
          AI-powered interface enabling natural language interactions. Features real-time data processing, multi-modal inputs, and adaptive learning.
        </p>
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(0, 181, 173, 0.15); color: var(--color-teal); border: 1px solid rgba(0, 181, 173, 0.3);">Python</span>
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(245, 166, 35, 0.15); color: var(--color-orange); border: 1px solid rgba(245, 166, 35, 0.3);">TensorFlow</span>
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(0, 181, 173, 0.15); color: var(--color-teal); border: 1px solid rgba(0, 181, 173, 0.3);">FastAPI</span>
        </div>
        <a href="#" class="text-sm font-semibold glow-text-teal transition-all inline-flex items-center gap-2">
          View Details
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="cellular-card p-8 h-full flex flex-col group hover:translate-y-[-2rem]">
        <div class="mb-6 p-6 rounded-xl" style="background: linear-gradient(135deg, rgba(245, 166, 35, 0.1), rgba(0, 181, 173, 0.1));">
          <svg viewBox="0 0 100 100" class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="20" y="20" width="60" height="60" opacity="0.5"/>
            <path d="M 50 35 L 65 50 L 50 65 L 35 50 Z" opacity="0.7"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold mb-3 glow-text-teal">Spatial Reality Platform</h3>
        <p class="text-sm mb-6 flex-grow" style="color: var(--color-dark); opacity: 0.85;">
          Cross-platform XR framework for immersive experiences. Supports mobile and desktop with spatial mapping, gesture recognition, and collaboration.
        </p>
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(245, 166, 35, 0.15); color: var(--color-orange); border: 1px solid rgba(245, 166, 35, 0.3);">Unity</span>
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(0, 181, 173, 0.15); color: var(--color-teal); border: 1px solid rgba(0, 181, 173, 0.3);">OpenXR</span>
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(245, 166, 35, 0.15); color: var(--color-orange); border: 1px solid rgba(245, 166, 35, 0.3);">C#</span>
        </div>
        <a href="#" class="text-sm font-semibold glow-text-teal transition-all inline-flex items-center gap-2">
          View Details
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="cellular-card p-8 h-full flex flex-col group hover:translate-y-[-2rem]">
        <div class="mb-6 p-6 rounded-xl" style="background: linear-gradient(135deg, rgba(0, 181, 173, 0.1), rgba(245, 166, 35, 0.1));">
          <svg viewBox="0 0 100 100" class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="25" y="30" width="50" height="40" opacity="0.6"/>
            <circle cx="40" cy="50" r="4" fill="currentColor" opacity="0.8"/>
            <circle cx="60" cy="50" r="4" fill="currentColor" opacity="0.8"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold mb-3 glow-text-teal">Backend Intelligence Hub</h3>
        <p class="text-sm mb-6 flex-grow" style="color: var(--color-dark); opacity: 0.85;">
          Scalable microservices with integrated AI. Handles millions of requests with analytics, predictive modeling, and autonomous optimization.
        </p>
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(0, 181, 173, 0.15); color: var(--color-teal); border: 1px solid rgba(0, 181, 173, 0.3);">Spring Boot</span>
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(245, 166, 35, 0.15); color: var(--color-orange); border: 1px solid rgba(245, 166, 35, 0.3);">Kubernetes</span>
          <span class="text-xs px-3 py-1 rounded-full" style="background: rgba(0, 181, 173, 0.15); color: var(--color-teal); border: 1px solid rgba(0, 181, 173, 0.3);">PostgreSQL</span>
        </div>
        <a href="#" class="text-sm font-semibold glow-text-teal transition-all inline-flex items-center gap-2">
          View Details
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="text-center mt-16">
      <a href="#" class="btn-primary inline-block">View All Projects</a>
    </div>
  </div>
</section>

<style>
  .cellular-card {
    transition: all 0.3s ease;
  }

  .cellular-card:hover {
    border-color: var(--color-teal);
    box-shadow: 0 20px 50px rgba(0, 181, 173, 0.15);
  }
</style>
