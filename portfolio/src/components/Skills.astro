---
---

<section id="skills" class="relative py-20 sm:py-28 px-6 sm:px-8 lg:px-16 overflow-hidden">
  <div class="absolute inset-0 -z-10 opacity-20">
    <div class="absolute top-0 left-10 w-80 h-80 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(0, 181, 173, 0.2);"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full mix-blend-multiply blur-3xl" style="background-color: rgba(245, 166, 35, 0.15);"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="mb-16 sm:mb-24 text-center">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6" style="color: var(--color-dark);">
        Skills <span class="glow-text">&</span> Expertise
      </h2>
      <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, var(--color-teal), var(--color-orange));"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="skill-cluster">
        <div class="skill-circle">
          <svg viewBox="0 0 200 200" class="w-full h-full">
            <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/>
            <circle cx="100" cy="100" r="50" fill="currentColor" opacity="0.08"/>
            <circle cx="60" cy="60" r="4" fill="currentColor" opacity="0.6"/>
            <circle cx="140" cy="60" r="4" fill="currentColor" opacity="0.6"/>
            <circle cx="100" cy="100" r="5" fill="currentColor" opacity="0.8"/>
            <circle cx="60" cy="140" r="4" fill="currentColor" opacity="0.6"/>
            <circle cx="140" cy="140" r="4" fill="currentColor" opacity="0.6"/>
            <line x1="60" y1="60" x2="100" y2="100" stroke="currentColor" stroke-width="1" opacity="0.4"/>
            <line x1="140" y1="60" x2="100" y2="100" stroke="currentColor" stroke-width="1" opacity="0.4"/>
            <line x1="60" y1="140" x2="100" y2="100" stroke="currentColor" stroke-width="1" opacity="0.4"/>
            <line x1="140" y1="140" x2="100" y2="100" stroke="currentColor" stroke-width="1" opacity="0.4"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-center mt-6 glow-text-teal">AI & ML</h3>
        <p class="text-center text-sm mt-3" style="color: var(--color-dark); opacity: 0.75;">Machine learning, LLM integration, neural networks</p>
      </div>

      <div class="skill-cluster">
        <div class="skill-circle">
          <svg viewBox="0 0 200 200" class="w-full h-full">
            <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/>
            <circle cx="100" cy="100" r="50" fill="currentColor" opacity="0.08"/>
            <path d="M 40 60 L 160 60 M 40 100 L 160 100 M 40 140 L 160 140" stroke="currentColor" stroke-width="1" opacity="0.3"/>
            <path d="M 60 40 L 60 160 M 100 40 L 100 160 M 140 40 L 140 160" stroke="currentColor" stroke-width="1" opacity="0.3"/>
            <polygon points="100,50 150,130 50,130" fill="currentColor" opacity="0.1"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-center mt-6 glow-text-teal">XR & 3D</h3>
        <p class="text-center text-sm mt-3" style="color: var(--color-dark); opacity: 0.75;">AR/VR, spatial computing, real-time graphics</p>
      </div>

      <div class="skill-cluster">
        <div class="skill-circle">
          <svg viewBox="0 0 200 200" class="w-full h-full">
            <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/>
            <circle cx="100" cy="100" r="50" fill="currentColor" opacity="0.08"/>
            <rect x="60" y="50" width="80" height="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            <rect x="60" y="80" width="80" height="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            <rect x="60" y="110" width="80" height="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            <rect x="60" y="140" width="80" height="20" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-center mt-6 glow-text-teal">Backend & DevOps</h3>
        <p class="text-center text-sm mt-3" style="color: var(--color-dark); opacity: 0.75;">Microservices, databases, cloud infrastructure</p>
      </div>

      <div class="skill-cluster">
        <div class="skill-circle">
          <svg viewBox="0 0 200 200" class="w-full h-full">
            <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/>
            <circle cx="100" cy="100" r="50" fill="currentColor" opacity="0.08"/>
            <rect x="50" y="50" width="100" height="100" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"/>
            <rect x="60" y="60" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            <rect x="105" y="60" width="35" height="15" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            <line x1="60" y1="100" x2="140" y2="100" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-center mt-6 glow-text-teal">Frontend & UI</h3>
        <p class="text-center text-sm mt-3" style="color: var(--color-dark); opacity: 0.75;">React, performance, UX design, animations</p>
      </div>
    </div>
  </div>
</section>

<style>
  .skill-cluster {
    text-align: center;
  }

  .skill-circle {
    width: 10rem;
    height: 10rem;
    margin: 0 auto;
    color: var(--color-teal);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .skill-cluster:hover .skill-circle {
    color: var(--color-orange);
    transform: scale(1.1) rotate(5deg);
    filter: drop-shadow(0 0 20px rgba(245, 166, 35, 0.4));
  }

  @media (max-width: 1024px) {
    .skill-circle {
      width: 8rem;
      height: 8rem;
    }
  }
</style>
