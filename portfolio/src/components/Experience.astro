---
const experiences = [
  {
    title: 'Senior Software Engineer',
    company: 'Innovation Labs',
    period: '2022 – Present',
    description: 'Leading frontend architecture and mentoring team of engineers. Improved performance metrics by 40% through optimization initiatives.',
    skills: ['React', 'TypeScript', 'System Design', 'Leadership'],
    highlight: true,
  },
  {
    title: 'Full Stack Engineer',
    company: 'Tech Startup',
    period: '2020 – 2022',
    description: 'Built scalable web applications serving 100k+ users. Implemented CI/CD pipelines and improved test coverage to 85%.',
    skills: ['Node.js', 'React', 'PostgreSQL', 'AWS'],
  },
  {
    title: 'Junior Developer',
    company: 'Digital Agency',
    period: '2018 – 2020',
    description: 'Developed client websites and web applications. Learned best practices in web development and cross-functional collaboration.',
    skills: ['JavaScript', 'HTML/CSS', 'React', 'Git'],
  },
];
---

<section id="experience" class="relative py-20 sm:py-32 px-6 sm:px-8 lg:px-16" style="background-color: var(--color-light);">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 -z-10 overflow-hidden hidden lg:block">
    <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob animation-delay-2000" style="background-color: var(--color-teal);" />
    <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob" style="background-color: var(--color-orange);" />
  </div>

  <div class="max-w-4xl mx-auto relative z-10">
    <div class="mb-12 sm:mb-20">
      <h2 class="text-4xl sm:text-5xl font-bold mb-4" style="color: var(--color-dark); font-family: 'Orbitron', sans-serif;">Professional Experience</h2>
      <p class="text-base sm:text-lg" style="color: var(--color-dark);">A timeline of my professional growth and achievements in software engineering.</p>
    </div>

    <div class="space-y-0">
      {experiences.map((exp, index) => (
        <div
          class="group relative py-8 sm:py-12 px-6 sm:px-8 rounded-xl sm:rounded-2xl smooth-transition"
          style={{
            borderLeft: '4px solid var(--color-teal)',
            backgroundColor: exp.highlight ? 'rgba(0, 181, 173, 0.08)' : 'transparent',
            borderColor: exp.highlight ? 'var(--color-teal)' : 'var(--color-teal)',
          }}
        >
          <!-- Timeline Dot -->
          <div
            class="absolute -left-4 top-8 sm:top-12 w-8 h-8 rounded-full border-4 border-white smooth-transition hidden sm:block"
            style={{
              backgroundColor: exp.highlight ? 'var(--color-teal)' : 'var(--color-dark)',
            }}
          />

          <!-- Content -->
          <div class="space-y-3 sm:space-y-4">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-2">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold group-hover:smooth-transition" style="color: var(--color-dark); font-family: 'Orbitron', sans-serif;">
                  {exp.title}
                </h3>
                <p class="text-base sm:text-lg font-medium" style="color: var(--color-teal);">{exp.company}</p>
              </div>
              <p class="text-xs sm:text-sm font-semibold px-3 py-1 bg-white rounded-full w-fit" style="color: var(--color-dark);">
                {exp.period}
              </p>
            </div>

            <p class="text-sm sm:text-base leading-relaxed" style="color: var(--color-dark);">
              {exp.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              {exp.skills.map((skill) => (
                <span class="px-3 py-1 text-xs sm:text-sm font-semibold rounded-full smooth-transition" style={{
                  backgroundColor: exp.highlight ? 'var(--color-teal)' : 'rgba(0, 181, 173, 0.1)',
                  color: exp.highlight ? 'var(--color-light)' : 'var(--color-dark)',
                  border: `1px solid var(--color-teal)`,
                }}>
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Highlight Badge -->
          {exp.highlight && (
            <div class="absolute top-6 right-6 flex items-center gap-2 px-3 py-1 rounded-full" style="backgroundColor: 'rgba(0, 181, 173, 0.1)', border: '1px solid var(--color-teal)'">
              <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--color-teal);" />
              <span class="text-xs font-semibold" style="color: var(--color-teal);">Current</span>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Summary Stats -->
    <div class="mt-12 sm:mt-16 grid grid-cols-3 gap-3 sm:gap-4 p-6 sm:p-8 rounded-xl sm:rounded-2xl" style="background: linear-gradient(135deg, var(--color-dark) 0%, rgba(26, 26, 26, 0.9) 100%);">
      <div class="text-center">
        <p class="text-2xl sm:text-3xl font-bold" style="color: var(--color-light);">8+</p>
        <p class="text-xs sm:text-sm mt-2" style="color: 'rgba(224, 232, 240, 0.7)';">Years Experience</p>
      </div>
      <div class="text-center">
        <p class="text-2xl sm:text-3xl font-bold" style="color: var(--color-light);">20+</p>
        <p class="text-xs sm:text-sm mt-2" style="color: 'rgba(224, 232, 240, 0.7)';">Projects Completed</p>
      </div>
      <div class="text-center">
        <p class="text-2xl sm:text-3xl font-bold" style="color: var(--color-light);">50+</p>
        <p class="text-xs sm:text-sm mt-2" style="color: 'rgba(224, 232, 240, 0.7)';">Happy Clients</p>
      </div>
    </div>
  </div>
</section>
