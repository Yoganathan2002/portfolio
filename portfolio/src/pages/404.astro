---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Not Found">
  <div class="min-h-screen flex flex-col items-center justify-center px-8">
    <h1 class="text-6xl font-bold text-slate-900 mb-4">404</h1>
    <p class="text-xl text-slate-600 mb-8">Page not found</p>
    <a href="/" class="px-6 py-3 bg-slate-900 text-white rounded-lg font-medium hover:bg-slate-800">
      Back to Home
    </a>
  </div>
</Layout>
